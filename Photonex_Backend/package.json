{
  "name": "photonex-backend",
  "version": "1.0.0",
  "description": "Backend API for Photonex - NPM and VS Code Marketplace monitoring dashboard",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun",
    "start": "bun src/main.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "npm",
    "vscode",
    "monitoring",
    "dashboard"
  ],
  "author": "DotJumpDot",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.0.0",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
